set MET_EXPORT_DIR = /media/model/met

set START_DATE="1984-01-01"
set END_DATE="2023-12-31"
#For ranking and best fit ranking files
set SCENARIOS_TO_RANK = ( stormVol_nldas2_tiled stormVol_daymet stormVol_prism )

set GEO_MET_MODEL = storm_volume
#Set the details of the feature on which amalgamate properties will be created and stored
set extent_hydrocode = cbp6_met_coverage
set extent_bundle = landunit
set extent_ftype = cbp_met_grid
set entity_type = dh_feature

set RATINGS_VARKEY = met_rating
set AMALGAMATE_SCENARIO = amalgamate_storm_vol

set RESAMPLE_VARKEY = daymet_mod_daily
set BACKGROUND_VARKEY = nldas2_precip_daily
set AMALGAMATE_VARKEY = amalgamate_daily
# PROMOTE_DATASET tells this to create a new varkey with the same name as this scenario
# this should be used sparingly, and if we tweak methods, can replace
set PROMOTE_DATASET = 1

#Set the details of the features from which ratings should be drawn
set COVERAGE_BUNDLE = watershed
set COVERAGE_FTYPE = usgs_full_drainage

