# config vars, in csh format
set PRECIP_DATA_SOURCES = ( nldas2 prism daymet )
# options "lm_month", "hires", "lm_weekly_err", "storm_sep"
# coverage for analytics and watershed precip analysis modeling
set COVERAGE_FTYPE = cbp6_landseg
set COVERAGE_BUNDLE = landunit
# for copy operations like in climate change for southern rivers we need a neighbor to grab
set neighbor_coverage_ftype = cbp6_landseg
# offset to accomodate datetime conversion glitches in seconds
set START_OFFSET = 0
set PRECIP_OPT_METHOD = none 
set MET_EXPORT_DIR = /media/model/met
set WDM_EXPORT_DIR = /backup/meteorology/out/lseg_csv
# default to old c++ based codes
set MET_PROCESS_METHOD = cbp6
set maskExtent = /opt/model/model_meteorology/data/cbp_extent.csv
# baseline data to use when creating wdms
set BASELINE_MET_SCENARIO = met2date
set BASELINE_FLOW_SCENARIO = subsheds
set RNMAX_DATA_PATH = /backup/meteorology/out/lseg_csv/RNMax
set RNMAX_DATA_SOURCE = /backup/meteorology/out/lseg_csv/met2date
# this is for computing start year and end year
set MODEL_TZ = America/New_York
# this is used for disagregating daymet and prism 7 hrs = 60 * 60 * 7 + 1 = 25201
# why the +1?  Because model end time is 23:59:59 so as to match cb wdm requirement
# but the prism/daymet daily end time is 12:00:00 
set DISSAG_TZ_OFFSET = 25201
# QA and analytics
set QA_LANDUSES = ( for )
set MODEL_VERSION_CODE = met-1.0
set NLDAS_ROOT = /backup/meteorology
