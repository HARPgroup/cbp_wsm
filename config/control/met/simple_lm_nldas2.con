#!/bin/csh
# config file for prism single source met input
# do not include quotes on strings as they get passed back with quotes...
set GEO_MET_MODEL = lm_simple
set MET_DATA_SOURCE = nldas2
set MET_EXPORT_DIR = /media/model/met
set START_DATE = 1984-01-01 00:00:00 EST
set START_OFFSET = 3600
set END_DATE = 2023-12-31 23:59:59 EST
#Set varkey
set varkey = nldas2_obs_hourly

#For met model runs only
set datasource = nldas2
set maskExtentLayer = "cbp_extent"

set extent_hydrocode = "cbp6_met_coverage"
set extent_bundle = "landunit"
set extent_ftype = "cbp_met_grid"
set entity_type = "dh_feature"
set tz_hr = 12
set TS_BAND = 10
set dt = 3600

set DB_FORCE_OVERWRITE = 0
set MET_PROCESS_METHOD = raster
set COVERAGE_FTYPE     = usgs_full_drainage 
set COVERAGE_BUNDLE     = watershed 

#Best fit ratings varkey
set RATINGS_BEST_VARKEY = met_best_rating
